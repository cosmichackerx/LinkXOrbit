{
  "name": "linkxorbit",
  "version": "1.1.0",
  "description": "LinkXOrbit — Windows desktop: LinkedIn session save and My Network Connect automation",
  "main": "dist/main/main.js",
  "author": "cosmichackerx",
  "license": "MIT",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/renderer','dist/renderer',{recursive:true})\" && node scripts/minify-dist.cjs",
    "start": "npm run build && electron .",
    "pack:win": "npm run build && node scripts/pack-win.cjs"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.linkxorbit.app",
    "productName": "LinkXOrbit",
    "publish": null,
    "electronVersion": "33.4.11",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": ["en-US"],
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "removePackageScripts": true,
    "afterPack": "./scripts/electron-after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "LinkXOrbit-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
